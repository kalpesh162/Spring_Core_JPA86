<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">


	<bean id="student" class="com.bean.Student">
		<property name="id" value="11">
		</property>
		<property name="name" value="Raju"></property>
		<property name="marks" value="78.45"></property>
		<property name="Address" ref="address"></property>
	</bean>


	<bean id="address" class="com.bean.Address">
		<property name="landMark" value="FC ROAD"></property>
		<property name="city" value="PUNE"></property>
		<property name="pincode" value="411020"></property>
	</bean>




</beans>